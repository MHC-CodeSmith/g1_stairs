# MJLab / MuJoCo-Warp environment for running Safe100Humanoid's own stair env (adapter checks, its evaluation).
# Versions from Safe100Humanoid/requirements-lock.txt. PYTORCH_JIT=0: torch.jit.script segfaults here while importing mjlab.
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends python3.11 python3.11-venv python3-pip git \
    libgl1 libegl1 libglib2.0-0 ffmpeg && rm -rf /var/lib/apt/lists/*
RUN python3.11 -m venv /venv
ENV PATH=/venv/bin:$PATH MUJOCO_GL=egl PYTORCH_JIT=0
RUN pip install --no-cache-dir torch==2.7.0 --index-url https://download.pytorch.org/whl/cu128
RUN pip install --no-cache-dir mjlab==1.2.0 mujoco==3.5.0 mujoco-warp==3.5.0 warp-lang==1.12.0 rsl-rl-lib==5.0.1 \
    tyro==1.0.15 onnx==1.22.0 onnxruntime imageio imageio-ffmpeg scipy
WORKDIR /workspace/g1_stairs
ENTRYPOINT ["python"]
